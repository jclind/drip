#!/usr/bin/env node
// @ts-check
// Turns a copy of manifest.json, src/ and icons/ into the Chrome Web Store build, then checks it. bin/build-release
// runs it on dist/drip-<version> before zipping, and test/release.test.js runs it on a copy of the working tree.
// Usage: bin/release-tree DIR    Exits 1 and says why when the build fails a check.

const fs = require('node:fs');
const path = require('node:path');
const vm = require('node:vm');

/** Folders the store build leaves out: the dev tools. */
const LEFT_OUT = ['src/devpanel'];

// The worker's imports of src/devpanel and the comment above them (src/background.js).
const DEV_IMPORTS = /(?:^\/\/[^\n]*\n)*(?:^importScripts\('devpanel\/[^']+'\);\n)+/gm;

/** Names from the dev tools that no shipped file may hold. */
const DEV_ANYWHERE = ['onMessageExternal', 'handleDev', 'runDevAction', 'runClock', 'DripDevClock', 'externally_connectable'];
/**
 * And names the worker, the rules, and the manifest may not hold either. Settings (src/options) still asks for
 * devStatus and keeps its Developer mode section hidden when the worker doesn't know the message.
 */
const DEV_IN_CORE = [...DEV_ANYWHERE, 'devStatus', 'devAction', 'setDevMode', 'devpanel', 'localhost'];
const CORE = ['manifest.json', 'src/background.js', 'src/lib/state.js'];

/**
 * Makes the copy in dir the store build: no dev tools in the files, the manifest, or the worker.
 * @param {string} dir
 */
function strip(dir) {
  for (const p of LEFT_OUT) fs.rmSync(path.join(dir, p), { recursive: true, force: true });
  const manifestFile = path.join(dir, 'manifest.json');
  const m = JSON.parse(fs.readFileSync(manifestFile, 'utf8'));
  delete m.externally_connectable;
  m.content_scripts = m.content_scripts.filter((/** @type {{js?: string[], css?: string[]}} */ c) =>
    ![...(c.js || []), ...(c.css || [])].some((f) => f.startsWith('src/devpanel/')));
  fs.writeFileSync(manifestFile, JSON.stringify(m, null, 2) + '\n');
  const worker = path.join(dir, m.background.service_worker);
  const source = fs.readFileSync(worker, 'utf8');
  const blocks = source.match(DEV_IMPORTS) || [];
  if (blocks.length !== 1) throw new Error(`release-tree: expected one block of devpanel imports in the worker, found ${blocks.length}`);
  fs.writeFileSync(worker, source.replace(DEV_IMPORTS, ''));
}

/** Every file under dir, as a path from dir with forward slashes. @param {string} dir @returns {string[]} */
function files(dir) {
  /** @param {string} rel @returns {string[]} */
  const walk = (rel) => fs.readdirSync(path.join(dir, rel), { withFileTypes: true }).flatMap((e) => {
    const p = rel ? `${rel}/${e.name}` : e.name;
    return e.isDirectory() ? walk(p) : [p];
  });
  return walk('').sort();
}

/** Whether a reference points outside the package: a scheme, a fragment, or a protocol-relative URL. @param {string} ref */
const external = (ref) => /^(?:[a-z][a-z0-9+.-]*:|#|\/\/)/i.test(ref) || ref === '';

/**
 * A reference from the file `from` as a path from the package root, or null if it's outside the package.
 * @param {string} from @param {string} ref @param {boolean} [fromRoot] Relative paths start at the root, as in the manifest.
 */
function resolve(from, ref, fromRoot = false) {
  if (external(ref)) return null;
  const clean = ref.split(/[?#]/)[0];
  if (clean.startsWith('/')) return path.posix.normalize(clean.slice(1));
  return path.posix.normalize(fromRoot ? clean : path.posix.join(path.posix.dirname(from), clean));
}

/** Matches a path with * in it, as web_accessible_resources does. @param {string} glob @param {string} file */
function globMatch(glob, file) {
  const re = new RegExp(`^${glob.split('*').map((s) => s.replace(/[.+?^${}()|[\]\\]/g, '\\$&')).join('.*')}$`);
  return re.test(file);
}

/** The url(...) references in CSS text. @param {string} css */
function cssUrls(css) {
  return [...css.matchAll(/url\(\s*(?:"([^"]*)"|'([^']*)'|([^'"\s)][^)]*?))\s*\)/g)].map((m) => m[1] ?? m[2] ?? m[3]);
}

/**
 * Every file path the manifest names.
 * @param {any} m
 * @returns {string[]}
 */
function manifestPaths(m) {
  /** @param {unknown} v @returns {string[]} */
  const values = (v) => (typeof v === 'string' ? [v] : v && typeof v === 'object' ? Object.values(v).flatMap(values) : []);
  return [
    m.background?.service_worker, m.action?.default_popup, ...values(m.action?.default_icon), m.options_page,
    m.options_ui?.page, ...values(m.icons), m.side_panel?.default_path, m.devtools_page,
    ...(m.content_scripts || []).flatMap((/** @type {any} */ c) => [...(c.js || []), ...(c.css || [])]),
    ...(m.web_accessible_resources || []).flatMap((/** @type {any} */ w) => w.resources || []),
  ].filter((p) => typeof p === 'string');
}

/**
 * What's wrong with the store build in dir, one sentence each. Empty when nothing is.
 * @param {string} dir
 * @returns {string[]}
 */
function check(dir) {
  /** @type {string[]} */
  const problems = [];
  const all = files(dir);
  const have = new Set(all);
  const read = (/** @type {string} */ f) => fs.readFileSync(path.join(dir, f), 'utf8');
  /** @param {string} from @param {string} ref @param {boolean} [fromRoot] */
  const need = (from, ref, fromRoot) => {
    const p = resolve(from, ref, fromRoot);
    if (p !== null && !have.has(p)) problems.push(`${from} names ${ref}, which isn't in the build`);
  };

  for (const p of [...LEFT_OUT, 'dev']) {
    if (all.some((f) => f.startsWith(`${p}/`))) problems.push(`${p} is in the build`);
  }

  let manifest;
  try {
    manifest = JSON.parse(read('manifest.json'));
  } catch (err) {
    return [...problems, `manifest.json doesn't parse: ${err}`];
  }
  for (const ref of manifestPaths(manifest)) {
    if (ref.includes('*')) {
      if (!all.some((f) => globMatch(ref, f))) problems.push(`manifest.json names ${ref}, which matches nothing in the build`);
    } else need('manifest.json', ref, true);
  }

  for (const f of all.filter((f) => f.endsWith('.html'))) {
    const html = read(f).replace(/&quot;/g, '"');
    for (const m of html.matchAll(/\s(?:src|href)\s*=\s*(["'])(.*?)\1/g)) need(f, m[2]);
    for (const ref of cssUrls(html)) need(f, ref);
  }
  for (const f of all.filter((f) => f.endsWith('.css'))) {
    for (const ref of cssUrls(read(f))) need(f, ref);
  }

  for (const f of all.filter((f) => f.endsWith('.js'))) {
    const text = read(f);
    try {
      new vm.Script(text, { filename: f });
    } catch (err) {
      problems.push(`${f} doesn't parse: ${err}`);
    }
    // chrome.runtime.getURL takes a path from the package root.
    for (const m of text.matchAll(/getURL\(\s*(['"])([^'"]+)\1\s*\)/g)) need(f, m[2], true);
    // importScripts takes a path from the worker's folder.
    for (const call of text.matchAll(/importScripts\(([^)]*)\)/g)) {
      for (const m of call[1].matchAll(/(['"])([^'"]+)\1/g)) need(f, m[2]);
    }
  }

  for (const f of all.filter((f) => /\.(js|json|html|css)$/.test(f))) {
    const text = read(f);
    for (const name of CORE.includes(f) ? DEV_IN_CORE : DEV_ANYWHERE) {
      if (text.includes(name)) problems.push(`${f} still has ${name}`);
    }
  }
  return problems;
}

module.exports = { strip, check, files, LEFT_OUT, DEV_ANYWHERE, DEV_IN_CORE };

if (require.main === module) {
  const dir = process.argv[2];
  if (!dir) {
    console.error('Usage: bin/release-tree DIR');
    process.exit(2);
  }
  strip(dir);
  const problems = check(dir);
  for (const p of problems) console.error(`build-release: ${p}`);
  if (problems.length) process.exit(1);
}
