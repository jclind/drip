#!/usr/bin/env node
// @ts-check
// Checks drip's YouTube selectors against live YouTube, so a markup change shows up here before a user hits it (Q25).
// Starts its own headless Chrome with a throwaway profile, so it's logged out: the home page has no videos then, and
// only the home page itself is checked. Reads each SEL object straight out of drip's content scripts, so the check
// can't drift from the code. No dependencies: Chrome DevTools Protocol over Node's built-in WebSocket.
//
// Usage: bin/check-youtube           prints what it found, exits 1 if anything is missing
//        bin/check-youtube --post    also posts a failure to DISCORD_WEBHOOK_URL, if set

const { spawn } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const ROOT = path.join(__dirname, '..');
const CHROME = process.env.CHROME || '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';

/** @param {string} file @returns {Record<string, string>} */
function selectors(file) {
  const source = fs.readFileSync(path.join(ROOT, file), 'utf8');
  const match = /const SEL = (\{[\s\S]*?\n {2}\});/.exec(source);
  if (!match) throw new Error(`no SEL object in ${file}`);
  return new Function(`return ${match[1]}`)();
}

/**
 * What each page must have. Keys name entries in a file's SEL. Selectors that only match after you've watched or
 * subscribed (watched markers, ads, the autoplay switch when it's off) aren't listed.
 * @returns {{name: string, url: string, need: [string, string][]}[]}
 */
function pages() {
  const watch = selectors('src/content/watch.js');
  const comments = selectors('src/content/comments.js');
  const search = selectors('src/content/search.js');
  const home = selectors('src/content/home.js');
  /** @param {string} file @param {Record<string, string>} sel @param {string[]} keys @returns {[string, string][]} */
  const pick = (file, sel, keys) => keys.map((k) => [`${file} ${k}`, sel[k]]);
  return [
    {
      name: 'watch',
      url: 'https://www.youtube.com/watch?v=jNQXAC9IVRw',
      need: [
        ...pick('watch.js', watch, ['video', 'watchPage', 'theaterButton', 'title', 'channel']),
        ...pick('comments.js', comments, ['comments']),
        // early.css hides these. If they're renamed, the sidebar comes back.
        ['early.css sidebar', 'ytd-watch-flexy #related'],
      ],
    },
    {
      name: 'search',
      url: 'https://www.youtube.com/results?search_query=mountain+biking',
      need: pick('search.js', search, ['results', 'primary', 'video', 'link', 'title', 'channel', 'length', 'saveSlot']),
    },
    {
      name: 'home',
      url: 'https://www.youtube.com/',
      need: pick('home.js', home, ['homeBrowse', 'mount']),
    },
  ];
}

async function main() {
  const post = process.argv.includes('--post');
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'drip-check-'));
  const chrome = spawn(CHROME, ['--headless=new', '--remote-debugging-port=0', `--user-data-dir=${dir}`,
    '--no-first-run', '--no-default-browser-check', '--mute-audio', 'about:blank'], { stdio: 'ignore' });
  /** @type {string[]} */
  const failures = [];
  /** @type {string[]} */
  const lines = [];
  try {
    const portFile = path.join(dir, 'DevToolsActivePort');
    for (let i = 0; i < 150 && !fs.existsSync(portFile); i++) await sleep(100);
    const port = fs.readFileSync(portFile, 'utf8').split('\n')[0];
    const targets = await (await fetch(`http://127.0.0.1:${port}/json`)).json();
    const ws = new WebSocket(targets.find((/** @type {any} */ t) => t.type === 'page').webSocketDebuggerUrl);
    await new Promise((resolve, reject) => { ws.onopen = resolve; ws.onerror = reject; });
    let nextId = 0;
    /** @type {Map<number, (msg: any) => void>} */
    const waiting = new Map();
    ws.onmessage = (event) => {
      const msg = JSON.parse(String(event.data));
      waiting.get(msg.id)?.(msg);
      waiting.delete(msg.id);
    };
    /** @param {string} method @param {object} [params] @returns {Promise<any>} */
    const cdp = (method, params = {}) => new Promise((resolve) => {
      const id = ++nextId;
      waiting.set(id, resolve);
      ws.send(JSON.stringify({ id, method, params }));
    });

    for (const page of pages()) {
      await cdp('Page.navigate', { url: page.url });
      /** @type {Record<string, number>} */
      let counts = {};
      // Wait up to 20 seconds for everything to show up.
      for (let i = 0; i < 40; i++) {
        await sleep(500);
        const expr = `JSON.stringify(Object.fromEntries(${JSON.stringify(page.need)}.map(([k, s]) => [k, document.querySelectorAll(s).length])))`;
        const res = await cdp('Runtime.evaluate', { expression: expr, returnByValue: true });
        counts = JSON.parse(res.result?.result?.value || '{}');
        if (page.need.every(([k]) => counts[k] > 0)) break;
      }
      const missing = page.need.filter(([k]) => !(counts[k] > 0));
      lines.push(`${page.name}: ${missing.length ? `missing ${missing.map(([k]) => k).join(', ')}` : 'ok'}`);
      for (const [k, s] of missing) failures.push(`${page.name}: ${k} (${s})`);
    }
    ws.close();
  } catch (err) {
    failures.push(`check failed to run: ${err instanceof Error ? err.message : String(err)}`);
  } finally {
    chrome.kill();
    setTimeout(() => fs.rmSync(dir, { recursive: true, force: true }), 1000).unref();
  }

  const when = new Date().toISOString();
  console.log(`${when} ${failures.length ? 'FAIL' : 'ok'}\n${lines.join('\n')}`);
  if (failures.length) {
    console.log(failures.join('\n'));
    const webhook = process.env.DISCORD_WEBHOOK_URL;
    if (post && webhook) {
      const content = `**drip**: YouTube changed something drip depends on.\n${failures.map((f) => `- ${f}`).join('\n')}\nSelectors are at the top of each file in \`src/content/\`.`;
      const res = await fetch(webhook, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ content: content.slice(0, 1900) }) });
      console.log(res.ok ? 'posted to Discord' : `Discord post failed: ${res.status}`);
    } else if (post) console.log('DISCORD_WEBHOOK_URL unset, not posted');
    process.exitCode = 1;
  }
}

/** @param {number} ms */
function sleep(ms) {
  return new Promise((r) => setTimeout(r, ms));
}

main();
